            "sensortypes":"EEG"
         }
      },
      {
         "Name":"process_psd",
         "Parameters":{
            "timewindow":[],
            "win_length":10,
            "win_overlap":50,
            "sensortypes":"EEG",
            "edit":{
               "Comment":"Power", 
               "TimeBands":[],
               "Freqs":[],
               "ClusterFuncTime":"none",
               "Measure":"power",
               "Output":"all",
               "SaveKernel":0
            }
        }
      },
      {
         "Name":"process_snapshot",
         "Parameters":{
            "target":10,
            "Comment":"Power spectrum density"
         }
      },
      {
         "Name":"process_ica",
         "Parameters":{
            "timewindow":[500, 700],
            "eventname":"",
            "eventtime":[],
            "sensortypes":"EEG",
            "ignorebad":1,
            "bandpass":[0, 0],
