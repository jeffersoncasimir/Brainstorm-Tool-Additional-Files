            "eventname":"SPIKE",
            "timewindow":[],
            "epochtime":[-0.3, 0.5],
            "createcond":1,
            "ignoreshort":1,
            "usectfcomp":1,
            "usessp":1,
            "freq":[],
            "baseline":[]
